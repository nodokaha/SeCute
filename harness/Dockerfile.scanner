# Scanner image for the SeCute harness.
# Contains only scanning tools; targets are mounted read-only at /target.
#
# Supply-chain pinning: the base image and the Trivy stage are pinned
# by digest, and every downloaded tool archive is verified against a
# SHA256 pinned next to its version below before it is unpacked. Each
# pinned hash comes from the project's published checksums file and
# was re-verified against the artifact it describes. To update a tool:
# bump its version, replace its SHA256 with the value from the new
# release's checksums file, and refresh the base image digest (use the
# tag's manifest-list digest from the registry).

# Trivy publishes no binary archives (and no checksums file) on its
# GitHub releases, so it is copied from the official image, pinned by
# digest, instead of piping a moving branch's install script into sh.
FROM aquasec/trivy:0.58.1@sha256:ab70a02200597efa04748f210f793936eb647cbcdb0ea69cc30b226d6f5a22c7 AS trivy

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

ARG GITLEAKS_VERSION=8.21.2
ARG GITLEAKS_SHA256=5bc41815076e6ed6ef8fbecc9d9b75bcae31f39029ceb55da08086315316e3ba
ARG OSV_SCANNER_VERSION=1.9.0
ARG OSV_SCANNER_SHA256=d9c1deedc23372a25049458e1e2f2bb9ad4098e2e2038118b9fec42f28f93ffb
ARG SYFT_VERSION=1.57.1
ARG SYFT_SHA256=bf52519eb57f675d47c07d43213cb6dff6449f3d6d1147ff6701ed91f44eef0c
ARG GRYPE_VERSION=0.121.3
ARG GRYPE_SHA256=e9da18cc1429e786722e32161288103600efffd8e483c90761f90485bd1bec85

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

RUN curl -sSL -o /tmp/gitleaks.tar.gz \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
 && rm /tmp/gitleaks.tar.gz

RUN curl -sSL -o /tmp/osv-scanner \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
 && echo "${OSV_SCANNER_SHA256}  /tmp/osv-scanner" | sha256sum -c - \
 && install -m 0755 /tmp/osv-scanner /usr/local/bin/osv-scanner \
 && rm /tmp/osv-scanner

COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy

RUN curl -sSL -o /tmp/syft.tar.gz \
      "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" \
 && echo "${SYFT_SHA256}  /tmp/syft.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/syft.tar.gz -C /usr/local/bin syft \
 && rm /tmp/syft.tar.gz

RUN curl -sSL -o /tmp/grype.tar.gz \
      "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz" \
 && echo "${GRYPE_SHA256}  /tmp/grype.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/grype.tar.gz -C /usr/local/bin grype \
 && rm /tmp/grype.tar.gz

# Bake the Grype vulnerability DB into the image so that scans run fully
# offline (--network none). Refresh the DB by rebuilding the image.
# The DB lives at a fixed path (not in root's home directory) and is
# world-readable, because the harness runs the container as a non-root
# user and Grype must still find it.
RUN mkdir -p /opt/grype/db \
 && GRYPE_DB_CACHE_DIR=/opt/grype/db grype db update \
 && chmod -R a+rX /opt/grype
ENV GRYPE_DB_AUTO_UPDATE=false GRYPE_DB_CACHE_DIR=/opt/grype/db

# Scans run as this non-root user by default. The harness also passes
# the host user's uid/gid explicitly; either way, never root.
RUN useradd --create-home --uid 10001 scanner
USER scanner

WORKDIR /work
